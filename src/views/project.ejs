<%- include('partials/header') %>

    <main class="container">
        <% if (projectDetails) { %>
            <h2>
                <%= projectDetails.title %>
            </h2>
            <p>
                Hosted by
                <a href="/organization/<%= projectDetails.organization_id %>">
                    <%= projectDetails.organization_name %>
                </a>
            </p>
            <p>
                <%= projectDetails.description %>
            </p>
            <p>Location: <%= projectDetails.location %>
            </p>
            <p>Date: <%= new Date(projectDetails.date).toLocaleDateString() %>
            </p>

            <% if (categories && categories.length> 0) { %>
                <ul class="category-tags">
                    <% categories.forEach(category=> { %>
                        <li>
                            <a href="/category/<%= category.category_id %>">
                                <%= category.name %>
                            </a>
                        </li>
                        <% }); %>
                </ul>
                <% } %>

                    <% if (user) { %>
                        <% if (isVolunteering) { %>
                            <p class="volunteer-status">You are volunteering for this project.</p>
                            <form action="/project/<%= projectDetails.project_id %>/unvolunteer" method="POST">
                                <button type="submit">Remove Me as a Volunteer</button>
                            </form>
                        <% } else { %>
                            <form action="/project/<%= projectDetails.project_id %>/volunteer" method="POST">
                                <button type="submit">Volunteer for This Project</button>
                            </form>
                        <% } %>
                    <% } %>

                    <% if (user && user.role_name === 'admin') { %>
                        <p><a href="/edit-project/<%= projectDetails.project_id %>">Edit Project</a></p>
                        <p><a href="/assign-categories/<%= projectDetails.project_id %>">Edit Categories</a></p>
                    <% } %>
                    <% } else { %>
                        <h2>Service Project Not Found</h2>
                        <p>We couldn't find the service project you're looking for.</p>
                        <% } %>
    </main>

    <%- include('partials/footer') %>