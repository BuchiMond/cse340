<%- include('partials/header') %>

<main>
    <h1><%= title %></h1>

    <h2>Dashboard</h2>
    <p>Name: <%= name %></p>
    <p>Username: <%= email %></p>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/users">View All Users</a></p>
    <% } %>

    <h2>Volunteering</h2>
    <% if (volunteerProjects && volunteerProjects.length > 0) { %>
        <ul class="project-list">
            <% volunteerProjects.forEach(project => { %>
                <li>
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    - <%= project.organization_name %>
                    (<%= new Date(project.date).toLocaleDateString() %>)
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                        <input type="hidden" name="returnTo" value="dashboard">
                        <button type="submit">Remove</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>You haven't volunteered for any projects yet. <a href="/projects">Browse service projects</a>.</p>
    <% } %>

</main>

<%- include('partials/footer') %>
